# JobRadar Backend Environment Configuration
# Copy this file to .env and configure your local credentials.

# Adzuna API Integration (Optional for live job scraping)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# SQLite Database Location (defaults to data/jobradar.db)
DATABASE_URL=sqlite:///data/jobradar.db

# Server Host & Port
HOST=127.0.0.1
PORT=8000
